# Copie para .env e preencha. NUNCA versione o .env real.

# Senha de acesso ao site (obrigatória — o servidor não inicia sem ela).
# Use 12+ caracteres. Após 5 erros em 15 min o login é bloqueado temporariamente.
APP_PASSWORD=coloque-uma-senha-forte

# Caminho do banco (no Docker/EasyPanel deixe dentro do volume persistente).
# Backups diários automáticos ficam em <pasta do banco>/backups (últimos 30).
DB_PATH=/app/data/controle.db

# Porta interna do app
PORT=3000

# ---- Meta conjunta (opcional): e-mail de comemoração quando a soma dos dois sites passar da meta ----
# Nos DOIS sites: a mesma chave secreta e o endereço do outro site
# MARCO_TOKEN=uma-chave-longa-igual-nos-dois-sites
# MARCO_PARCEIRO_URL=https://fernanda.hafner.work
# Só no site que envia o e-mail:
# MARCO_EMAIL_PARA=voce@gmail.com
# SMTP_USER=voce@gmail.com
# SMTP_PASS=senha-de-app-do-gmail   (myaccount.google.com/apppasswords)
# MARCO_VALOR=100000
