# Copie para .env e preencha. NUNCA versione o .env real.

# Senha de acesso ao site (a única que você vai digitar para entrar)
APP_PASSWORD=coloque-uma-senha-forte

# Segredo para assinar o cookie de sessão. Gere uma string longa aleatória, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cole-aqui-uma-string-aleatoria-bem-longa

# Caminho do banco (no Docker/EasyPanel deixe dentro do volume persistente)
DB_PATH=/app/data/controle.db

# Porta interna do app
PORT=3000
