# Copie para .env e preencha. NUNCA versione o .env real.

# Senha de acesso ao site (obrigatória — o servidor não inicia sem ela).
# Use 12+ caracteres. Após 5 erros em 15 min o login é bloqueado temporariamente.
APP_PASSWORD=coloque-uma-senha-forte

# Caminho do banco (no Docker/EasyPanel deixe dentro do volume persistente).
# Backups diários automáticos ficam em <pasta do banco>/backups (últimos 30).
DB_PATH=/app/data/controle.db

# Porta interna do app
PORT=3000
